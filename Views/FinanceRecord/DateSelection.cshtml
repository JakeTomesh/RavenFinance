@model RavenFinance.Models.FinaceRecord
@{
}
<p>Select the date range of new finacne record.</p>
<form asp-action="DateSelection" asp-controller="FinanceRecord" method="post">
    <label asp-for="DateStart"></label>
    <input type="date" asp-for="DateStart" />
    
    <label asp-for="DateEnd"></label>
    <input type="date" asp-for="DateEnd" />
    
    <button type="submit">Next</button>
</form>
