@model IEnumerable<RavenFinance.Models.Saving>
@{
    ViewData["Title"] = "Savings";
}


<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col text-end">
            <a asp-action="Create" asp-controller="Saving" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add a new Savings
            </a>
        </div>
    </div>
    <partial name="_UserMessage" />

    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var saving in Model)
                    {
                        <tr>
                            <td>@saving.Name</td>

                            <td>

                                <a asp-action="Edit" asp-route-categoryId="@saving.SavingId" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil">Edit</i>
                                </a>
                                <a asp-action="Delete" asp-route-categoryId="@saving.SavingId" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash">Delete</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p class="mb-0">No Savings found. <a asp-action="Create" asp-controller="Saving">Add your first Savings</a></p>
        </div>
    }
</div>
