@model RavenFinance.Models.RecurringBill
@{
    ViewData["Title"] = "Details for Recurring Bill";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col text-end">
            <a asp-action="Index" asp-controller="RecurringBill" class="btn btn-warning">
                <span>Back</span>
            </a>
        </div>

    </div>
    <partial name="_UserMessage" />

        <div>
            <div>
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="Amount"></label>
            <input asp-for="Amount" type="number" min="0" step="0.01" max="10000" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="DueDate">Due on day of month</label>
            <input asp-for="DueDate" min="1" max="31" step="1" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="Category"></label>
                <input value="@Model.Category.Name" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="PaymentSource"></label>
                <input value="@Model.PaymentSource.Name" class="form-control" readonly />
            </div>
            <div>
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" rows="7" cols="10" class="form-control" readonly></textarea>
            </div>
            <div>
                <label asp-for="IsSplit"></label>
                <input asp-for="IsSplit" type="checkbox" value="@Model.IsSplit" readonly disabled/>
            </div>
        </div>
       
</div>