@model RavenFinance.Models.RecurringBill
@{
    ViewData["Title"] = "Delete Recurring Bills";
}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2 class="text-danger">@ViewData["Title"]</h2>
            <hr />
            <h4>Are you sure you want to delete this recurring bill?</h4>
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">Amount</dt>
                        <dd class="col-sm-8">@Model.Amount</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category.Name</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">Payment Source</dt>
                        <dd class="col-sm-8">@Model.PaymentSource.Name</dd>
                    </dl>
                    <dl class="row">
                        <dt class="col-sm-4">Due on Day of Month</dt>
                        <dd class="col-sm-8">@Model.DueDate</dd>
                    </dl>
                </div>
            </div>

            <form asp-controller="RecurringBill" asp-action="DeleteRecurringBill" method="post" class="mt-3">
                <input type="hidden" asp-for="@Model.RecurringBillId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
