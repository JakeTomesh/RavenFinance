
@{
    ViewData["Title"] = "Dashboard";
}
<div>
    <h1>@ViewData["Title"]</h1>
</div>
<partial name="_UserMessage" />
<div>
    <p>CONTROLS</p>
    <form asp-controller="RecurringBill" asp-action="Index" method="get">
        <button class="btn btn-danger">MONTHLY RECURRING BILLS</button>
    </form>
    <button class="btn btn-success">SAVINGS</button>
    <form asp-controller="Category" asp-action="Index" method="get">
        <button class="btn btn-warning">CATEGORIES</button>
    </form>
    <form asp-controller="PaymentSource" asp-action="Index" method="get">
        <button class="btn btn-info">PAYMENT SOURCE</button>
    </form>
    <button class="btn btn-info">INCOME</button>


</div>
<div class="dashboard-container">
    <h2>VISUAL SUMMARY OF MONTHLY FINANCES</h2>
    <div class="container-fluid">
        <div class="border col-md-4">
            <p>MONTHLY RECURRING BILLS</p>
        </div>
        <div class="border col-md-6">
            <p>CATEGORY TOTALS</p>
        </div>
        <div class="border">
            <p>SAVINGS GOALS/TOTALS</p>
        </div>
        <div class="border">
            <p>INCOME TOTALS</p>
        </div>
        <div class="border">
            <p>LINES OF CREDIT W/ TOTALS</p>
        </div>
    </div>
</div>
