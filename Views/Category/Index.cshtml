@model IEnumerable<RavenFinance.Models.Category>
@{
    ViewData["Title"] = "Categories";
}


<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col text-end">
            <a asp-action="Create" asp-controller="Category" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add a Category
            </a>
        </div>
    </div>
    <div>
        @if(TempData["SuccessMessage"] != null)
        {
            <span class="text-success fw-bold">@TempData["SuccessMessage"]</span>
        }
    </div>

    @if (Model?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.Name</td>
                            
                            <td>
                                <a asp-action="Details" asp-route-id="@category.CategoryId" class="btn btn-sm btn-info" title="Details">
                                    <i class="bi bi-eye">Details</i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="bi bi-pencil">Edit</i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-sm btn-danger" title="Delete"
                                       onclick="return confirm('Are you sure you want to delete this category?');">
                                    <i class="bi bi-trash">Delete</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p class="mb-0">No categories found. <a asp-action="Create" asp-controller="Category">Add your first category</a></p>
        </div>
    }
</div>
